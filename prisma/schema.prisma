// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Next 16 middleware Proxy configuration details
datasource db {
  provider = "postgresql"
}

model Bank {
  id              String    @id @default(uuid())
  userId          String    // Appwrite User $id reference
  accessToken     String    // Encrypted Plaid Access Token
  itemId          String    @unique // Plaid Item ID
  institutionId   String
  institutionName String
  status          String    @default("CONNECTED") // CONNECTED, DISCONNECTED, REAUTH_REQUIRED
  accounts        Account[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

model Account {
  id               String        @id // Plaid Account ID
  bankId           String
  bank             Bank          @relation(fields: [bankId], references: [id], onDelete: Cascade)
  name             String
  nickname         String?
  mask             String
  officialName     String?
  type             String        // checking, savings, credit, investment
  subtype          String?
  balanceCurrent   Float
  balanceAvailable Float?
  balanceLimit     Float?
  transactions     Transaction[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([bankId])
}

model Transaction {
  id           String   @id // Plaid Transaction ID
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount       Float    // Negative = Income/Deposit, Positive = Expense/Withdrawal (Plaid default)
  date         DateTime
  name         String   // Transaction Description / Merchant
  merchantName String?  // Plaid Merchant Name (if resolved)
  category     String   // Joined comma-separated primary categories
  status       String   // pending, completed, failed, refunded
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([accountId])
  @@index([date])
}

model Recipient {
  id            String     @id @default(uuid())
  userId        String     // Owner (Appwrite ID)
  name          String
  email         String
  routingNumber String
  accountNumber String
  isFavorite    Boolean    @default(false)
  transfers     Transfer[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
}

model Transfer {
  id                 String     @id @default(uuid())
  userId             String     // Sender (Appwrite ID)
  amount             Float
  type               String     // INTERNAL (local accounts), EXTERNAL (to recipient)
  senderAccountId    String     // Source Account ID
  recipientAccountId String?    // For internal transfers: Destination Account ID
  recipientId        String?    // For external transfers: Destination Recipient ID
  recipient          Recipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  status             String     // PENDING, COMPLETED, FAILED
  scheduledDate      DateTime?  // Optional for scheduled transactions
  idempotencyKey     String     @unique // Unique submission lock
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([userId])
  @@index([idempotencyKey])
}

model Budget {
  id        String   @id @default(uuid())
  userId    String   // Appwrite User ID
  category  String   // e.g., 'Food & Dining', 'Rent & Housing', etc.
  limit     Float    // Maximum spending limit
  month     Int      // 1-12
  year      Int      // e.g., 2026
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category, month, year])
  @@index([userId])
}

model SavingsGoal {
  id            String   @id @default(uuid())
  userId        String   // Appwrite User ID
  name          String   // e.g., 'Tesla Model Y', 'Emergency Fund'
  targetAmount  Float
  currentAmount Float    @default(0)
  targetDate    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model AiSummary {
  id                     String   @id @default(uuid())
  userId                 String   // Appwrite User ID
  month                  Int      // 1-12
  year                   Int
  spendingSummary        String
  incomeSummary          String
  expenseBreakdown       String
  savingsRecommendations String
  budgetSuggestions      String
  financialHealthScore   Int      // 0-100
  healthScoreExplanation String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String   // Appwrite User ID
  role      String   // 'user' | 'assistant'
  content   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Subscription {
  id              String   @id @default(uuid())
  userId          String   // Owner (Appwrite ID)
  name            String   // Merchant / Subscription Name
  amount          Float
  frequency       String   // 'monthly' | 'annually'
  category        String
  nextPaymentDate DateTime
  status          String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model Bill {
  id        String   @id @default(uuid())
  userId    String   // Owner (Appwrite ID)
  name      String   // Billing Merchant Name
  amount    Float
  dueDate   DateTime
  status    String   @default("UNPAID") // UNPAID | PAID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   // Target User
  type      String   // 'LARGE_WITHDRAWAL' | 'SALARY_RECEIVED' | 'BUDGET_EXCEEDED' | 'UPCOMING_BILL'
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AutomationRule {
  id            String   @id @default(uuid())
  userId          String   // Owner (Appwrite ID)
  triggerType   String   // 'BALANCE_BELOW' | 'SPENDING_EXCEEDS'
  triggerValue  Float
  actionType    String   // 'ALERT_INBOX' | 'AUTO_TRANSFER'
  actionDetails String   // Specific configuration info
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  // Associated User (if authenticated)
  action    String   // e.g., 'AUTH_LOGIN_SUCCESS', 'DWOLLA_TRANSFER_INITIATED'
  details   String   // JSON metadata of the event
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model FraudCase {
  id              String   @id @default(uuid())
  userId          String
  transactionId   String   @unique
  riskScore       Int      // 0-100
  confidenceScore Int      // 0-100
  reasons         String   // JSON list of triggered reasons (e.g. ['LARGE_PURCHASE'])
  explanation     String   @db.Text
  status          String   @default("UNDER_REVIEW") // UNDER_REVIEW | APPROVED | CONFIRMED_FRAUD
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
}
